{
  "name": "actra-obsidian-plugin",
  "version": "1.0.3",
  "private": true,
  "description": "ACTRA community plugin for OAuth-based, user-authorized vault synchronization.",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "review:mobile": "node scripts/mobile-review.mjs",
    "review:security": "node scripts/security-review.mjs",
    "check": "pnpm run lint && pnpm run test && pnpm run build && pnpm run review:mobile && pnpm run review:security"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.11.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.13.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
